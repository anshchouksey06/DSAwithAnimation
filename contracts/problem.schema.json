{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NormalizedProblem",
  "type": "object",
  "required": [
    "schema_version",
    "problem_id",
    "title",
    "statement",
    "input",
    "target",
    "language",
    "assumptions",
    "constraints"
  ],
  "properties": {
    "schema_version": { "type": "string", "enum": ["1.0"] },
    "problem_id": { "type": "string" },
    "title": { "type": "string" },
    "statement": { "type": "string" },
    "input": {
      "type": "object",
      "required": ["nums"],
      "properties": {
        "nums": {
          "type": "array",
          "items": { "type": "integer" }
        }
      }
    },
    "target": { "type": "integer" },
    "language": {
      "type": "string",
      "enum": ["cpp", "java", "python", "javascript"]
    },
    "assumptions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "constraints": {
      "type": "array",
      "items": { "type": "string" }
    },
    "source_url": { "type": ["string", "null"] }
  }
}
