{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ScenePlan",
  "type": "object",
  "required": ["schema_version", "aspect_ratio", "fps", "scenes"],
  "properties": {
    "schema_version": { "type": "string", "enum": ["1.0"] },
    "aspect_ratio": { "type": "string", "enum": ["9:16"] },
    "fps": { "type": "integer", "enum": [30] },
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["scene_id", "component", "props", "narration_segment_id"],
        "properties": {
          "scene_id": { "type": "string" },
          "component": {
            "type": "string",
            "enum": [
              "IntroScene",
              "ArrayScene",
              "BruteForceScene",
              "HashMapScene",
              "ComplexityScene",
              "SummaryScene"
            ]
          },
          "props": { "type": "object" },
          "narration_segment_id": { "type": "string" },
          "duration_frames": { "type": "integer" }
        }
      }
    }
  }
}
